<section class="panel">
  <h1>Editar avistamiento</h1>
  <p>{{avistamiento.nombreComun}} · <em>{{avistamiento.nombreCientifico}}</em></p>
  <form action="/api/avistamientos/update/{{avistamiento._id}}" method="post">
    <div class="campos">
      <label>Zona
        <input name="zona" value="{{avistamiento.zona}}" required>
      </label>
      <label>Estado de conservación
        <select name="estadoConservacion" required>
          {{#each estados}}
            <option value="{{valor}}" {{#if seleccionado}}selected{{/if}}>{{valor}}</option>
          {{/each}}
        </select>
      </label>
    </div>
    <div class="acciones">
      <button type="submit">Guardar cambios</button>
      <a href="/#avistamientos">Cancelar</a>
    </div>
  </form>
</section>
